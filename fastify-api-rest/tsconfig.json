{
  // 루트 공통 TypeScript 정책을 상속하고, API 서버 패키지의 경로만 별도로 지정합니다.
  "extends": "../tsconfig.json",

  "compilerOptions": {
    // 서버 소스만 컴파일 대상으로 삼아 테스트/빌드 산출물이 dist에 섞이지 않도록 합니다.
    "rootDir": "./src",
    "outDir": "./dist"
  },

  // 테스트 파일은 Vitest가 별도로 처리하므로, 앱 런타임 소스만 타입 검사 대상으로 둡니다.
  "include": ["src/**/*", "src/shared"],
  "exclude": ["node_modules", "dist"]
}
